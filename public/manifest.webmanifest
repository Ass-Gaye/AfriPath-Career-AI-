  ],
  "shortcuts": [
    {
      "name": "Discover Careers",
      "short_name": "Careers",
      "description": "Explore 40+ high-growth tech & vocational African careers",
      "url": "/?tab=careers&source=pwa-shortcut",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Career Assessment",
      "short_name": "Assessment",
      "description": "Take the personalized Pan-African skill & ambition assessment",
      "url": "/?tab=assessment&source=pwa-shortcut",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI Career Advisor",
      "short_name": "AI Advisor",
      "description": "Chat in real-time with your localized African career mentor",
      "url": "/?tab=mentor&source=pwa-shortcut",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Career Path",
      "short_name": "My Path",
      "description": "View your personalized gap analysis, milestones, and target career",
      "url": "/?tab=my-path&source=pwa-shortcut",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Verified Opportunities",
